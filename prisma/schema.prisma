generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String       @default("USER")
  createdAt     DateTime     @default(now())
  accounts      Account[]
  cloudBackup   CloudBackup?
  sessions      Session[]
  readingProgress ReadingProgress[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CloudBackup {
  id        String   @id @default(cuid())
  userId    String   @unique
  stats     Json?
  sessions  Json?
  profile   Json?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rank {
  id         String   @id @default(cuid())
  type       String   @unique
  title      String
  minWpm     Int
  maxWpm     Int
  svgContent String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Badge {
  id          String   @id @default(cuid())
  badgeId     String   @unique
  title       String
  description String
  rarity      String
  category    String?
  quote       String?
  svgContent  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String
  targetType  String
  targetValue Int
  svgContent  String?
  rewardBadge String?
  activeFrom  DateTime?
  activeTo    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PracticeBook {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  content             String?
  compressedContent   String?
  words               String[]
  originalSize        Int?
  compressionRatio    Float?
  contentHash         String?
  isActive            Boolean   @default(false)
  startDate           DateTime?
  endDate             DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  readingProgress     ReadingProgress[]
}

model ReadingProgress {
  userId    String
  bookId    String
  position  Int       @default(0)
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      PracticeBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
}



// ── Multiplayer races (P2P WebRTC; Postgres used for signaling + matchmaking) ──

model RaceRoom {
  code        String   @id
  hostPeerId  String
  status      String   @default("open") // open | started | closed
  capacity    Int      @default(4)
  skillBucket Int      @default(0)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime
  signals     RaceSignal[]

  @@index([status, isPublic, skillBucket])
  @@index([expiresAt])
}

model RaceSignal {
  id        Int      @id @default(autoincrement())
  roomCode  String
  fromPeer  String
  toPeer    String?  // null = room broadcast
  type      String   // offer | answer | ice | join | leave | started | closed
  payload   Json
  createdAt DateTime @default(now())
  room      RaceRoom @relation(fields: [roomCode], references: [code], onDelete: Cascade)

  @@index([roomCode, toPeer, id])
  @@index([roomCode, id])
}
